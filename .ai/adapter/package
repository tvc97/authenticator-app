#!/bin/sh
# Archive + export a signed .ipa. Never publishes.
. "$(dirname "$0")/common.sh"
require_project
ver=${1:-} ; [ -n "$ver" ] || die "usage: package <version>"
out="$ROOT/$(mval artifacts.dir)/$ver"
mkdir -p "$out"

say "package $ver"
[ -n "$(mval project.team_id)" ] || die "manifest project.team_id is empty.
  Signing must never be guessed. Fill it in, or stop."

with_device_lock xcb archive \
  $(proj_flag) -scheme "$(mval project.scheme)" \
  -configuration Release -destination 'generic/platform=iOS' \
  -archivePath "$out/$(mval project.scheme).xcarchive" \
  || die "archive failed"
ok "archive"

[ -f "$ADAPTER/ExportOptions.plist" ] || die "missing $ADAPTER/ExportOptions.plist (export method + team). Create it once, commit it."
xcb -exportArchive \
  -archivePath "$out/$(mval project.scheme).xcarchive" \
  -exportOptionsPlist "$ADAPTER/ExportOptions.plist" \
  -exportPath "$out" || die "export failed"
ok "ipa exported"
ls -1 "$out"/*.ipa
