#!/bin/sh
# Regression test for the gates themselves.
#
# scope-check and the flow state machine are the whole compensating control introduced by
# ADR-002: no CI, no human approver, so a silent regression in the APPROVE check or the
# human-path match would not be caught by anything. The Swift tiers do not exercise a line
# of it. This does.
#
# Runs against a throwaway git repo in a temp dir. Touches nothing in the real tree.
set -eu

SELF=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$SELF/../../.." && pwd)
pass=0; fail=0

green() { printf '\033[32m  PASS\033[0m %s\n' "$1"; pass=$((pass+1)); }
red()   { printf '\033[31m  FAIL\033[0m %s\n' "$1"; fail=$((fail+1)); }

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM

# A minimal repo that satisfies common.sh: it only needs .ai/adapter/manifest.yml to exist.
setup() {
  rm -rf "$TMP/wt"; mkdir -p "$TMP/wt/.ai/adapter/checks"
  cp "$REPO/.ai/adapter/manifest.yml" "$TMP/wt/.ai/adapter/manifest.yml"
  cp "$REPO/.ai/adapter/common.sh"    "$TMP/wt/.ai/adapter/common.sh"
  cp "$REPO/.ai/adapter/checks/scope-check" "$TMP/wt/.ai/adapter/checks/scope-check"
  chmod +x "$TMP/wt/.ai/adapter/checks/scope-check"
  git -C "$TMP/wt" init -q
  git -C "$TMP/wt" config user.email t@t.t
  git -C "$TMP/wt" config user.name t
  git -C "$TMP/wt" add -A
  git -C "$TMP/wt" commit -qm base
  git -C "$TMP/wt" branch -M main
  git -C "$TMP/wt" checkout -qb task/99-gate-test
}

# run_check -> prints output, returns scope-check's exit status
run_check() { ( cd "$TMP/wt" && ./.ai/adapter/checks/scope-check main 99 2>&1 ); }

commit_file() {
  mkdir -p "$TMP/wt/$(dirname "$1")"
  printf '%s\n' "$2" > "$TMP/wt/$1"
  git -C "$TMP/wt" add -A
  git -C "$TMP/wt" commit -qm "touch $1"
}

write_review() {
  mkdir -p "$TMP/wt/.ai/run/99"
  { printf 'issue: 99\ncommit: %s\nverdict: %s\n' "$1" "$2"; } > "$TMP/wt/.ai/run/99/review.yml"
}

head_of() { git -C "$TMP/wt" rev-parse --short HEAD; }

printf '\033[1m==>\033[0m gate regression tests\n'

# 1. A clean diff outside every guarded list passes.
setup
commit_file "docs/notes.md" "hello"
if run_check >/dev/null 2>&1; then green "unguarded path passes"; else red "unguarded path should pass"; fi

# 2. A human_path is a hard failure, with or without a review.
setup
commit_file "authenticator/Info.plist" "x"
out=$(run_check || true)
case "$out" in *"human-only paths modified"*) green "human_path hard-fails" ;; *) red "human_path should hard-fail: $out" ;; esac

# 3. A human_path fails even when an APPROVE is on record.
setup
commit_file "authenticator/Info.plist" "x"
write_review "$(head_of)" APPROVE
out=$(run_check || true)
case "$out" in *"human-only paths modified"*) green "human_path ignores an APPROVE" ;; *) red "APPROVE must not unlock a human_path: $out" ;; esac

# 4. A review_path with no review on record is refused.
setup
commit_file ".ai/adapter/env" "x"
out=$(run_check || true)
case "$out" in *"no cold review is on record"*) green "review_path without a verdict is refused" ;; *) red "missing verdict should refuse: $out" ;; esac

# 5. A review_path with REQUEST_CHANGES is refused.
setup
commit_file ".ai/adapter/env" "x"
write_review "$(head_of)" REQUEST_CHANGES
out=$(run_check || true)
case "$out" in *"not APPROVE"*) green "REQUEST_CHANGES is refused" ;; *) red "REQUEST_CHANGES should refuse: $out" ;; esac

# 6. A stale APPROVE (reviewed before the last commit) is refused.
setup
commit_file ".ai/adapter/env" "x"
write_review "$(head_of)" APPROVE
commit_file ".ai/adapter/build" "y"          # a commit lands AFTER the review
out=$(run_check || true)
case "$out" in *"STALE"*) green "stale APPROVE is refused" ;; *) red "stale APPROVE should refuse: $out" ;; esac

# 7. A fresh APPROVE at HEAD passes.
setup
commit_file ".ai/adapter/env" "x"
write_review "$(head_of)" APPROVE
if run_check >/dev/null 2>&1; then green "fresh APPROVE at HEAD passes"; else red "fresh APPROVE should pass: $(run_check || true)"; fi

# 8. A rename OUT of a guarded directory is still seen. This is why --no-renames exists:
#    with rename detection on the diff names only the destination, so no rule matches and
#    crypto walks out of the guarded tree unreviewed. The file must pre-exist on main --
#    created and moved on the same branch, the net diff legitimately shows only the
#    destination, and there is nothing for the check to catch.
setup
git -C "$TMP/wt" checkout -q main
commit_file "authenticator/Crypto/HMAC.swift" "let a = 1"
git -C "$TMP/wt" branch -qD task/99-gate-test
git -C "$TMP/wt" checkout -qb task/99-gate-test      # branch AFTER the file exists on main
mkdir -p "$TMP/wt/authenticator/Util"
git -C "$TMP/wt" mv authenticator/Crypto/HMAC.swift authenticator/Util/HMAC.swift
git -C "$TMP/wt" commit -qm "move crypto out"
out=$(run_check || true)
case "$out" in *"no cold review is on record"*|*"Crypto"*) green "rename out of Crypto is caught" ;; *) red "rename out of a guarded dir must be caught: $out" ;; esac

# 9. A verdict smuggled somewhere other than the top-level key does not count.
setup
commit_file ".ai/adapter/env" "x"
mkdir -p "$TMP/wt/.ai/run/99"
printf 'issue: 99\ncommit: %s\nitems:\n  - verdict: APPROVE\n' "$(head_of)" > "$TMP/wt/.ai/run/99/review.yml"
out=$(run_check || true)
case "$out" in *"not APPROVE"*|*"no cold review"*) green "a nested verdict does not count" ;; *) red "nested verdict must not count: $out" ;; esac

printf '\033[1m==>\033[0m %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ] || exit 1
